# Explicit demo mode. Unset or false uses configured providers and never invents a response.
DEMO_MODE=false
ADMIN_EMAIL=admin@vale.local
ADMIN_PASSWORD=
SESSION_SECRET=

# Required when DEMO_MODE=false. Never prefix this with NEXT_PUBLIC_.
CACHE_HMAC_SECRET=

# Pooled Lakebase Postgres URL. When set, repositories use Postgres. Tests stay in memory.
DATABASE_URL=
# Direct URL for schema changes. Optional; the app falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
REDIS_URL=

# Optional real provider routing. Ignored while DEMO_MODE=true.
LITELLM_BASE_URL=
LITELLM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
